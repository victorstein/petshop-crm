rules_version = '2';  

// Current data struccture
// User
//  / socialMedia
//  / profilePicture
// Shelter
//  / address
//  / logo
//  / shelterMedia
// ShelteredAnimal
//  / profilePicture
//  / gallery
// Breed

// is profile owner or admin
function isProfileOwnerOrAdmin(userId) {
  return request.auth.uid == userId || get(/databases/$(database)/documents/User/$(request.auth.uid)).data.role == 'admin';
}

// is shelter owner or admin
function isShelterOwnerOrAdmin(shelterId) {
  return get(/databases/$(database)/documents/Shelter/$(shelterId)).data.shelterOwner == request.auth.uid || get(/databases/$(database)/documents/User/$(request.auth.uid)).data.role == 'admin';
}

// is sheltered animal owner or admin
function isShelteredAnimalOwnerOrAdmin(shelteredAnimalId) {
  return get(/databases/$(database)/documents/ShelteredAnimal/$(shelteredAnimalId)).data.shelterOwner == request.auth.uid || get(/databases/$(database)/documents/User/$(request.auth.uid)).data.role == 'admin';
}

// check if user is admin
function isAdmin() {
  return get(/databases/$(database)/documents/User/$(request.auth.uid)).data.role == 'admin';
}


service cloud.firestore {
  match /databases/{database}/documents {
    match /User/{userId} {
      allow read;
      allow create: if request.resource.data.role != 'admin';
      allow update: if isProfileOwnerOrAdmin(userId);
      allow delete: if isProfileOwnerOrAdmin(userId);
      match /socialMedia/{socialMediaId} {
        allow read;
        allow write: if isProfileOwnerOrAdmin(userId);
      }
      match /profilePicture/{profilePictureId} {
        allow read;
        allow write: if isProfileOwnerOrAdmin(userId);
      }
    }

    match /Breed/{breedId} {
      allow read;
      allow write: if isAdmin();
    }

    match /Shelter/{shelterId} {
      allow read;
      allow write: if isShelterOwnerOrAdmin(shelterId);
      match /address {
        allow read;
        allow write: if isShelterOwnerOrAdmin(shelterId);
      }
      match /logos {
        allow read;
        allow write: if isShelterOwnerOrAdmin(shelterId);
      }
      match /shelterMedia {
        allow read;
        allow write: if isShelterOwnerOrAdmin(shelterId);
      }
    }

    match /ShelteredAnimal/{shelteredAnimalId} {
      allow read;
      allow write: if isShelteredAnimalOwnerOrAdmin(shelteredAnimalId);
      match /profilePicture {
        allow read;
        allow write: if isShelteredAnimalOwnerOrAdmin(shelteredAnimalId);
      }
      match /gallery {
        allow read;
        allow write: if isShelteredAnimalOwnerOrAdmin(shelteredAnimalId);
      }
    }
  }
}